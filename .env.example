# ==============================================================================
# IntelliVest Environment Configuration Template
# ==============================================================================

# Database Connection URLs (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
POSTGRES_PASSWORD=replace_with_a_local_development_password
ADVISORY_DB_URL=postgresql://postgres:replace_with_a_local_development_password@localhost:5434/advisory_db
RISK_DB_URL=postgresql://postgres:replace_with_a_local_development_password@localhost:5433/risk_db

# Market Data Provider
MARKET_DATA_PROVIDER=yfinance


# Application Gateway / Backend Settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Open the frontend at http://127.0.0.1:5173; /api proxies to APP_HOST:APP_PORT.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Risk & Sizing Engine Defaults
DEFAULT_LIQUID_SAFETY_RESERVE=50000.00
DEFAULT_VAR_CONFIDENCE_LEVEL=0.95
DEFAULT_TARGET_HHI_LIMIT=0.25
RISK_VAR_LIMIT_PERCENT=0.10
RISK_DAILY_VOLATILITY_LIMIT=0.03

RECOMMENDATION_PRICE_CHANGE_FRACTION=0.02
STOCK_ANNUAL_RISK_FREE_RATE=0.04
# Yahoo Finance via yfinance: personal educational/research use; may be delayed.
MARKET_QUOTE_REFRESH_SECONDS=300
MARKET_QUOTE_STALE_SECONDS=1800
MARKET_CLOSE_MAX_AGE_DAYS=7
MARKET_HISTORY_CACHE_SECONDS=3600
MARKET_PROVIDER_BACKOFF_SECONDS=300
YFINANCE_TIMEOUT_SECONDS=8
