# ==============================================================================
# IntelliVest Environment Configuration Template
# ==============================================================================

# Database Connection URLs (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
ADVISORY_DB_URL=postgresql://postgres:postgres@localhost:5434/advisory_db
RISK_DB_URL=postgresql://postgres:postgres@localhost:5433/risk_db

# Market Data Provider
# Default: "yfinance" (Supported options: "yfinance", "alpha_vantage", "twelvedata")
MARKET_DATA_PROVIDER=yfinance

# External API Keys (Optional / Provider-specific)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
FINANCIAL_MODELING_PREP_API_KEY=your_fmp_api_key_here

# Application Gateway / Backend Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=intellivest_super_secret_dev_key_change_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Risk & Sizing Engine Defaults
DEFAULT_LIQUID_SAFETY_RESERVE=50000.00
DEFAULT_VAR_CONFIDENCE_LEVEL=0.95
DEFAULT_TARGET_HHI_LIMIT=0.25
RISK_VAR_LIMIT_PERCENT=0.10
RISK_DAILY_VOLATILITY_LIMIT=0.03
